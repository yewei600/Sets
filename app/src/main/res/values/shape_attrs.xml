<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="Shape">
        <attr name="shapeType" format="enum">
            <enum name="TRIANGLE" value="0" />
            <enum name="SQUARE" value="1" />
            <enum name="CIRCLE" value="2" />
        </attr>
        <attr name="fillType" format="enum">
            <enum name="FILL" value="0" />
            <enum name="EMPTY" value="1" />
            <enum name="LINES" value="2" />
        </attr>
        <attr name="colorType" format="enum">
            <enum name="RED" value="0" />
            <enum name="GREEN" value="1" />
            <enum name="BLUE" value="2" />
        </attr>
    </declare-styleable>
</resources>